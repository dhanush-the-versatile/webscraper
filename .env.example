# =============================================================================
# Talent Discovery Platform - Environment Configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# =============================================================================

# ---- General ----
ENVIRONMENT=development                 # development | staging | production
PROJECT_NAME="Talent Discovery Platform"
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=false                          # true for structured JSON logs (prod)

# ---- Security ----
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=43200      # 30 days
ALGORITHM=HS256
# Comma-separated list of allowed CORS origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- PostgreSQL ----
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=talent
POSTGRES_PASSWORD=talent
POSTGRES_DB=talent
# Optional full override (takes precedence if set):
# DATABASE_URL=postgresql+asyncpg://talent:talent@db:5432/talent

# ---- Redis / Celery ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- AI providers (optional; heuristic fallback used when absent) ----
# Provider preference: auto | openai | anthropic | heuristic
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Search / data-source providers (optional; sample data used when absent) ----
# SerpAPI is used as an official, ToS-compliant search API abstraction.
SERPAPI_API_KEY=
BING_SEARCH_API_KEY=
GITHUB_TOKEN=                           # increases GitHub public API rate limits

# ---- Scraping behaviour ----
SCRAPER_USER_AGENT="TalentDiscoveryBot/1.0 (+https://example.com/bot)"
SCRAPER_MAX_CONCURRENCY=5
SCRAPER_REQUEST_TIMEOUT=20
SCRAPER_MIN_DELAY_SECONDS=1.0           # respectful pacing between requests per host
SCRAPER_MAX_RETRIES=3
SCRAPER_RESPECT_ROBOTS=true
SCRAPER_HTTP_PROXY=                     # optional forward proxy (no restriction bypass)

# ---- OAuth (optional social login) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
